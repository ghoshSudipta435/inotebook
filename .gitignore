# Root-level ignores
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore .env files (common practice)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore coverage and build files
coverage/
build/

/node_modules
# Ignore frontend dependencies and builds
/frontend/node_modules
/frontend/build
/frontend/.env
/frontend/.env.local

# Ignore backend dependencies and builds
/backend/node_modules
/backend/.env
/backend/.env.local

# Ignore Yarn Plug'n'Play files (if using Yarn PnP)
/.pnp
.pnp.js
